# systemd unit — install on the VPS with:
#   sudo cp deploy/plushboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now plushboard
# Assumes the repo lives at /opt/plushboard with backend/.venv built
# (python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt)
# and frontend built (make build). HTTPS terminates at the reverse proxy
# (Caddy/nginx) in front of 127.0.0.1:8000.

[Unit]
Description=Plushboard — smallplushies.com ops dashboard
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/plushboard/backend
EnvironmentFile=/opt/plushboard/.env
ExecStart=/opt/plushboard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
